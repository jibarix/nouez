{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_nouez_consultants__NouezSettings",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -I \"${CLAUDE_PLUGIN_DATA}/app/server.py\" guard",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -I \"${CLAUDE_PLUGIN_DATA}/app/server.py\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
